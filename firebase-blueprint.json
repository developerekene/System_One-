{
  "entities": {
    "SecurityPreferences": {
      "title": "SecurityPreferences",
      "description": "Cross-platform security preferences for a unified System One account.",
      "type": "object",
      "properties": {
        "twoFactorNotice": {
          "type": "boolean",
          "description": "Whether enhanced multi-factor verification reminders are enabled."
        },
        "loginAlerts": {
          "type": "boolean",
          "description": "Notify user when a new SSO session begins."
        },
        "sessionTimeoutMinutes": {
          "type": "number",
          "enum": [15, 30, 60, 240, 1440],
          "description": "Preferred idle session duration across connected apps."
        },
        "requireReauthForSensitive": {
          "type": "boolean",
          "description": "Require fresh authentication before changing security preferences or revoking apps."
        },
        "trustedRedirectOnly": {
          "type": "boolean",
          "description": "Restrict SSO redirect_to transitions to registered app URIs or verified origins."
        },
        "passwordRecoveryEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Backup recovery email address."
        },
        "humanVerified": {
          "type": "boolean",
          "description": "Whether the user has passed interactive human verification on the profile page."
        },
        "humanVerifiedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp when human verification was completed."
        },
        "biometricsEnabled": {
          "type": "boolean",
          "description": "Whether mobile biometric login has been activated."
        },
        "pinConfigured": {
          "type": "boolean",
          "description": "Whether a 6-digit security PIN is configured for desktop/web access."
        },
        "pinHash": {
          "type": "string",
          "maxLength": 128,
          "description": "SHA-256 salted digest of the 6-digit security PIN."
        },
        "pinUpdatedAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp when the 6-digit PIN was last set or rotated."
        },
        "pinExpiresAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp 90 days after pinUpdatedAt when the PIN must be changed."
        },
        "authenticatorEnabled": {
          "type": "boolean",
          "description": "Whether the built-in 6-digit TOTP authenticator is activated."
        },
        "authenticatorSecret": {
          "type": "string",
          "maxLength": 64,
          "description": "Base32 secret key used by the built-in 6-digit TOTP authenticator."
        }
      },
      "required": [
        "twoFactorNotice",
        "loginAlerts",
        "sessionTimeoutMinutes",
        "requireReauthForSensitive",
        "trustedRedirectOnly",
        "passwordRecoveryEmail",
        "humanVerified",
        "humanVerifiedAt",
        "biometricsEnabled",
        "pinConfigured",
        "pinHash",
        "pinUpdatedAt",
        "pinExpiresAt",
        "authenticatorEnabled",
        "authenticatorSecret"
      ]
    },
    "NotificationPreferences": {
      "title": "NotificationPreferences",
      "description": "Cross-platform notification channel and event settings.",
      "type": "object",
      "properties": {
        "securityDigest": {
          "type": "boolean",
          "description": "Weekly account security summary."
        },
        "newDeviceAlert": {
          "type": "boolean",
          "description": "Immediate alert on new platform sign-in."
        },
        "appAuthorizationAlert": {
          "type": "boolean",
          "description": "Alert when a connected application connects or changes status."
        },
        "profileUpdateAlert": {
          "type": "boolean",
          "description": "Notify across devices when profile details are updated."
        },
        "webEnabled": {
          "type": "boolean",
          "description": "Deliver notifications to web apps."
        },
        "mobileEnabled": {
          "type": "boolean",
          "description": "Deliver notifications to mobile apps."
        },
        "desktopEnabled": {
          "type": "boolean",
          "description": "Deliver notifications to desktop apps."
        }
      },
      "required": [
        "securityDigest",
        "newDeviceAlert",
        "appAuthorizationAlert",
        "profileUpdateAlert",
        "webEnabled",
        "mobileEnabled",
        "desktopEnabled"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Unified System One identity profile, elaborate personal/contact/address/work details, and cross-platform preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Primary account email."
        },
        "secondaryEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Optional secondary or backup email."
        },
        "firstName": {
          "type": "string",
          "maxLength": 40,
          "description": "User first name."
        },
        "lastName": {
          "type": "string",
          "maxLength": 40,
          "description": "User last name."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "User display name across all System One connected applications."
        },
        "handle": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9_.-]*$",
          "description": "Unified cross-app username handle."
        },
        "dateOfBirth": {
          "type": "string",
          "maxLength": 20,
          "description": "User date of birth in YYYY-MM-DD format."
        },
        "gender": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional gender or pronouns preference."
        },
        "bio": {
          "type": "string",
          "maxLength": 300,
          "description": "Short personal introduction."
        },
        "phone": {
          "type": "string",
          "maxLength": 32,
          "description": "Phone number."
        },
        "website": {
          "type": "string",
          "maxLength": 200,
          "description": "Personal website or portfolio link."
        },
        "streetAddress": {
          "type": "string",
          "maxLength": 120,
          "description": "Street address."
        },
        "city": {
          "type": "string",
          "maxLength": 60,
          "description": "City."
        },
        "stateRegion": {
          "type": "string",
          "maxLength": 60,
          "description": "State, province, or region."
        },
        "postalCode": {
          "type": "string",
          "maxLength": 24,
          "description": "Postal or ZIP code."
        },
        "country": {
          "type": "string",
          "maxLength": 80,
          "description": "Country."
        },
        "location": {
          "type": "string",
          "maxLength": 80,
          "description": "Formatted city/country summary."
        },
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "description": "User timezone."
        },
        "preferredLanguage": {
          "type": "string",
          "maxLength": 40,
          "description": "Preferred interface language."
        },
        "occupation": {
          "type": "string",
          "maxLength": 80,
          "description": "Job title or occupation."
        },
        "company": {
          "type": "string",
          "maxLength": 80,
          "description": "Company, school, or organization."
        },
        "emergencyContactName": {
          "type": "string",
          "maxLength": 80,
          "description": "Emergency contact person name."
        },
        "emergencyContactPhone": {
          "type": "string",
          "maxLength": 32,
          "description": "Emergency contact phone number."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL."
        },
        "primaryPlatform": {
          "type": "string",
          "enum": ["web", "mobile", "desktop"],
          "description": "User's primary access platform."
        },
        "linkedProviders": {
          "type": "array",
          "description": "Bound sign-in providers such as google.com and password."
        },
        "tags": {
          "type": "array",
          "description": "Organizational tags applied to the unified account."
        },
        "securityPreferences": {
          "type": "object",
          "$ref": "#/entities/SecurityPreferences",
          "description": "Security preferences object."
        },
        "notificationPreferences": {
          "type": "object",
          "$ref": "#/entities/NotificationPreferences",
          "description": "Notification preferences object."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update."
        }
      },
      "required": [
        "uid",
        "email",
        "secondaryEmail",
        "firstName",
        "lastName",
        "displayName",
        "handle",
        "dateOfBirth",
        "gender",
        "bio",
        "phone",
        "website",
        "streetAddress",
        "city",
        "stateRegion",
        "postalCode",
        "country",
        "location",
        "timezone",
        "preferredLanguage",
        "occupation",
        "company",
        "emergencyContactName",
        "emergencyContactPhone",
        "photoURL",
        "primaryPlatform",
        "linkedProviders",
        "tags",
        "securityPreferences",
        "notificationPreferences",
        "createdAt",
        "updatedAt"
      ]
    },
    "ConnectedApp": {
      "title": "ConnectedApp",
      "description": "Registered mobile, desktop, or web application authorized through System One SSO.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID of the connected application."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Display name of the connected application."
        },
        "platform": {
          "type": "string",
          "enum": ["web", "mobile", "desktop"],
          "description": "Origin platform of the connected application."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Concise purpose of this connected app."
        },
        "redirectUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Registered callback URL or mobile deep-link used by redirect_to."
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "revoked"],
          "description": "Authorization state for this application."
        },
        "tags": {
          "type": "array",
          "description": "Up to 8 organizational tags."
        },
        "scopes": {
          "type": "array",
          "description": "Up to 8 granted SSO scopes."
        },
        "lastPlatformSource": {
          "type": "string",
          "enum": ["web", "mobile", "desktop"],
          "description": "Most recent platform used to launch or return to this app."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of app registration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last status or configuration change."
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "platform",
        "description",
        "redirectUri",
        "status",
        "tags",
        "scopes",
        "lastPlatformSource",
        "createdAt",
        "updatedAt"
      ]
    },
    "SecurityEvent": {
      "title": "SecurityEvent",
      "description": "Authentication, redirect transition, and security audit log entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID of the security event."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Human-readable description of the event."
        },
        "category": {
          "type": "string",
          "enum": ["auth", "redirect", "security", "profile", "app"],
          "description": "Event category."
        },
        "platform": {
          "type": "string",
          "enum": ["web", "mobile", "desktop"],
          "description": "Platform from which the event originated."
        },
        "provider": {
          "type": "string",
          "maxLength": 40,
          "description": "Authentication provider or transition mechanism."
        },
        "targetUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Associated redirect_to URL if applicable."
        },
        "tags": {
          "type": "array",
          "description": "Up to 8 organizational tags."
        },
        "status": {
          "type": "string",
          "enum": ["verified", "completed", "pending", "revoked"],
          "description": "Outcome status of the event."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the event."
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "category",
        "platform",
        "provider",
        "targetUrl",
        "tags",
        "status",
        "createdAt"
      ]
    },
    "AccountTag": {
      "title": "AccountTag",
      "description": "User-defined organizational tag for categorizing connected apps, settings, and events.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID of the tag."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Short tag name."
        },
        "description": {
          "type": "string",
          "maxLength": 120,
          "description": "What this tag organizes."
        },
        "tone": {
          "type": "string",
          "enum": ["slate", "sky", "emerald", "amber", "indigo"],
          "description": "Light-mode visual category tone."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of tag creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of tag update."
        }
      },
      "required": [
        "id",
        "ownerId",
        "label",
        "description",
        "tone",
        "createdAt",
        "updatedAt"
      ]
    },
    "AccountNotification": {
      "title": "AccountNotification",
      "description": "Cross-platform account notification synced across web, mobile, and desktop apps.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID of the notification."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Plain-language notification title."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Plain-language notification details."
        },
        "category": {
          "type": "string",
          "enum": ["account", "security", "app", "system"],
          "description": "Notification category."
        },
        "sourcePlatform": {
          "type": "string",
          "enum": ["web", "mobile", "desktop"],
          "description": "Platform that generated this notification."
        },
        "targetPlatforms": {
          "type": "array",
          "description": "Platforms this notification is delivered to (web, mobile, desktop)."
        },
        "read": {
          "type": "boolean",
          "description": "Whether the user has read this notification."
        },
        "readAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO timestamp when the notification was marked read."
        },
        "actionUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional app or route link related to the notification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of notification creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last read/status update."
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "message",
        "category",
        "sourcePlatform",
        "targetPlatforms",
        "read",
        "readAt",
        "actionUrl",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private unified account profile and preferences owned strictly by userId."
    },
    "/users/{userId}/connectedApps/{appId}": {
      "schema": { "$ref": "#/entities/ConnectedApp" },
      "description": "Connected mobile, desktop, and web applications authorized under the user's SSO profile."
    },
    "/users/{userId}/securityEvents/{eventId}": {
      "schema": { "$ref": "#/entities/SecurityEvent" },
      "description": "Immutable audit log entries for authentication and redirect_to transitions."
    },
    "/users/{userId}/tags/{tagId}": {
      "schema": { "$ref": "#/entities/AccountTag" },
      "description": "User-managed tags for organizing connected applications and security activity."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AccountNotification" },
      "description": "Cross-platform notifications accessible across all user platforms (web, mobile, desktop)."
    }
  }
}
